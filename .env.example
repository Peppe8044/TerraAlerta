# Copiar a .env y ajustar. No subir .env real al repositorio.
# Ninguna de estas variables requiere una clave de API de pago en el MVP.

ENVIRONMENT=development

# Backend (services/api)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Base de datos (solo scaffolding para fases futuras; el MVP no depende de
# ella para servir los indicadores actuales — ver docs/ARQUITECTURA.md).
POSTGRES_USER=terraalerta
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=terraalerta
DATABASE_URL=postgresql://terraalerta:change-me-local-only@localhost:5432/terraalerta

# Frontend (apps/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Fuentes pendientes de aprobación (NO activar sin verificar licencia,
# ver docs/DATOS.md y docs/FUENTES_ESTADO.md). Dejar vacío hasta entonces.
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
DGA_API_KEY=
DMC_API_KEY=
COPERNICUS_CDSE_CLIENT_ID=
COPERNICUS_CDSE_CLIENT_SECRET=
